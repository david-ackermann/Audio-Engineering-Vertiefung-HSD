desc:Simple PM FM Oscillator

slider1:PRESET=1<0,2,1{Manual,PM,FM}>preset
slider2:MODE=0<0,1,1{PM,FM}>mode
slider3:MOD_SHAPE=0<0,2,1{Sine,Triangle,Rectangle}>modulator shape
slider4:F_C_HZ=220<20,5000,0.01:sqr>f_c carrier frequency (Hz)
slider5:F_M_HZ=5<0.05,1000,0.01:sqr>f_m modulation frequency (Hz)
slider6:BETA_RAD=4.712<0,12.566,0.001>beta PM phase index (rad)
slider7:DELTA_F_HZ=23.56<0,2000,0.01:sqr>delta_f FM deviation (Hz)
slider8:OUT_DB=-12<-36,6,0.1>output (dB)

out_pin:left output
out_pin:right output

@init
carrier_phase = 0;
mod_phase = 0;

smooth_ms = 10;
smooth_a = exp(-1 / (0.001 * smooth_ms * srate));
smooth_b = 1 - smooth_a;

PRESET_i = floor(PRESET + 0.5);
PRESET_last = -1;
MODE_i = floor(MODE + 0.5);
MOD_SHAPE_i = floor(MOD_SHAPE + 0.5);

F_C_HZ_t = F_C_HZ;
F_M_HZ_t = F_M_HZ;
BETA_RAD_t = BETA_RAD;
DELTA_F_HZ_t = DELTA_F_HZ;
OUT_GAIN_t = 10^(OUT_DB / 20);

F_C_HZ_s = F_C_HZ_t;
F_M_HZ_s = F_M_HZ_t;
BETA_RAD_s = BETA_RAD_t;
DELTA_F_HZ_s = DELTA_F_HZ_t;
OUT_GAIN_s = OUT_GAIN_t;

@slider
PRESET_i = floor(min(max(PRESET, 0), 2) + 0.5);

PRESET_i != PRESET_last ? (
    PRESET_i == 1 ? (
        // PM preset: phi(t) = beta*m(t).
        MODE = 0;
        MOD_SHAPE = 0;
        F_C_HZ = 220;
        F_M_HZ = 5;
        BETA_RAD = 4.712;
        DELTA_F_HZ = 23.56;
        OUT_DB = -12;
    ) : (
        PRESET_i == 2 ? (
            // FM preset: f_i(t) = f_c + delta_f*m(t).
            // For a sine modulator, delta_f = beta*f_m gives the same
            // phase amplitude as the PM reference.
            MODE = 1;
            MOD_SHAPE = 0;
            F_C_HZ = 220;
            F_M_HZ = 5;
            BETA_RAD = 4.712;
            DELTA_F_HZ = 23.56;
            OUT_DB = -12;
        );
    );
    PRESET_last = PRESET_i;
    sliderchange(2 + 4 + 8 + 16 + 32 + 64 + 128);
);

MODE_i = floor(min(max(MODE, 0), 1) + 0.5);
MOD_SHAPE_i = floor(min(max(MOD_SHAPE, 0), 2) + 0.5);

F_C_HZ_t = min(max(F_C_HZ, 20), min(5000, srate * 0.45));
F_M_HZ_t = min(max(F_M_HZ, 0.05), min(1000, srate * 0.45));
BETA_RAD_t = min(max(BETA_RAD, 0), 12.566);
DELTA_F_HZ_t = min(max(DELTA_F_HZ, 0), 2000);
OUT_GAIN_t = 10^(OUT_DB / 20);

@sample
F_C_HZ_s += (F_C_HZ_t - F_C_HZ_s) * smooth_b;
F_M_HZ_s += (F_M_HZ_t - F_M_HZ_s) * smooth_b;
BETA_RAD_s += (BETA_RAD_t - BETA_RAD_s) * smooth_b;
DELTA_F_HZ_s += (DELTA_F_HZ_t - DELTA_F_HZ_s) * smooth_b;
OUT_GAIN_s += (OUT_GAIN_t - OUT_GAIN_s) * smooth_b;

// Modulator m[n], normalized to -1...+1.
MOD_SHAPE_i == 0 ? (
    m = sin(mod_phase);
) : (
    MOD_SHAPE_i == 1 ? (
        p = mod_phase / (2 * $pi);
        p < 0.25 ? (
            m = 4 * p;
        ) : (
            p < 0.75 ? (
                m = 2 - 4 * p;
            ) : (
                m = -4 + 4 * p;
            );
        );
    ) : (
        m = sin(mod_phase) >= 0 ? 1 : -1;
    );
);

mod_phase += 2 * $pi * F_M_HZ_s / srate;
mod_phase >= 2 * $pi ? mod_phase -= 2 * $pi;

MODE_i == 0 ? (
    // PM: y[n] = cos(2*pi*f_c*n/f_s + beta*m[n]).
    carrier_phase += 2 * $pi * F_C_HZ_s / srate;
    carrier_phase >= 2 * $pi ? carrier_phase -= 2 * $pi;
    y = cos(carrier_phase + BETA_RAD_s * m);
) : (
    // FM: y[n] = cos(phi[n]), phi[n] = phi[n-1] + 2*pi*f_i[n]/f_s.
    f_inst = F_C_HZ_s + DELTA_F_HZ_s * m;
    f_inst = min(max(f_inst, 0), srate * 0.45);
    carrier_phase += 2 * $pi * f_inst / srate;
    carrier_phase >= 2 * $pi ? carrier_phase -= 2 * $pi;
    y = cos(carrier_phase);
);

spl0 = y * OUT_GAIN_s;
spl1 = y * OUT_GAIN_s;
